# Prisma / SQLite
DATABASE_URL="file:./dev.db"

# 스크립트/아이디어 생성 (Anthropic API)
ANTHROPIC_API_KEY=

# TTS
ELEVENLABS_API_KEY=

# 이미지 생성
IMAGE_API_KEY=

# YouTube Data API v3 (분석용, 읽기)
YOUTUBE_API_KEY=

# YouTube 업로드용 OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# 자막 번인(ASS)에는 libass가 필요 — 기본 ffmpeg 포뮬러에는 없어 ffmpeg-full 등 별도 빌드 경로를 지정한다.
# 비워두면 PATH의 ffmpeg/ffprobe를 그대로 사용한다.
FFMPEG_PATH=
FFPROBE_PATH=

# yt-dlp 실행 파일 경로(비우면 PATH의 yt-dlp). YouTube PO-Token 방어로 stable 버전 다운로드가 403이 나면
# 최신 nightly 바이너리 경로를 지정한다(예: ~/.local/bin/yt-dlp, `yt-dlp --update-to nightly`로 설치).
YTDLP_PATH=
# (선택) 403/PO-Token 우회용 브라우저 쿠키 소스. 예: chrome / safari / firefox. "chrome:Profile 1" 형태도 가능.
YTDLP_COOKIES_FROM_BROWSER=
