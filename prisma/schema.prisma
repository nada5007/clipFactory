// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum VideoFormat {
  SHORT // 9:16, 최대 180초
  LONG // 16:9, 최대 1800초
}

enum ProjectStatus {
  DRAFT
  SCRIPTING
  IMAGING
  TTS
  EDITING
  RENDERED
  UPLOADED
  FAILED
}

enum ReviewStatus {
  PENDING
  REVIEWED
}

enum CreationType {
  MANUAL
  AI_AUTO
}

model Channel {
  id                        String      @id @default(cuid())
  name                      String
  youtubeChannelId          String?
  videoFormat               VideoFormat @default(SHORT)
  // 스크립트/이미지/TTS/영상/업로드 등 나머지 채널 기본값 (탭별 상세 스키마는 해당 기능 구현 시 확정)
  // SQLite에서 Json @default가 지원되지 않아 애플리케이션 레벨(services)에서 기본값 "{}"를 채운다.
  defaultSettings           Json
  isActive                  Boolean     @default(true)
  // YouTube 업로드용 OAuth 2.0 토큰 (youtube.upload + youtube.readonly scope)
  oauthAccessToken          String?
  oauthRefreshToken         String?
  oauthAccessTokenExpiresAt DateTime?
  oauthConnectedAt          DateTime?
  projects                  Project[]
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
}

model Project {
  id            String         @id @default(cuid())
  title         String
  description   String?
  channelId     String
  channel       Channel        @relation(fields: [channelId], references: [id])
  status        ProjectStatus  @default(DRAFT)
  reviewStatus  ReviewStatus   @default(PENDING)
  creationType  CreationType   @default(MANUAL)
  videoFormat   VideoFormat
  progress      Int            @default(0)
  // 생성 시 채널의 defaultSettings를 복사한 뒤 프로젝트에서 override (기본값은 services에서 채움)
  settings      Json
  errorMessage  String?
  script        Script?
  audioSegments AudioSegment[]
  images        ImageAsset[]
  video         VideoAsset?
  thumbnail     ThumbnailAsset?
  timeline      Timeline?
  jobs          Job[]
  uploadConfig  UploadConfig?
  uploadedMedia UploadedMedia[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Script {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic        String
  title        String
  hook         String
  body         String
  // 장면별 이미지 프롬프트 (문자열 배열, 영어)
  imagePrompts Json
  model        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 대본을 문장 단위로 분리해 생성한 TTS 음성 세그먼트. startMs/endMs는 이전 세그먼트들의
// 실제 오디오 길이를 순차 누적해 계산한다 (BGM은 이 단계 범위 밖 — 채널/프로젝트 BGM 설정은 별도 구현).
model AudioSegment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  text      String
  startMs   Int
  endMs     Int
  // storage/{projectId}/ 기준 상대 경로
  filePath  String
  provider  String
  voiceId   String
  model     String
  // 프로바이더별 세부 파라미터 (오디오 포맷/음성 지시문/안정성·유사도 부스트·스타일·속도 등)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, order])
}

// 대본의 장면별 이미지 프롬프트로 생성한 이미지. order는 Script.imagePrompts 배열의 인덱스와 대응한다.
// 씬 타이밍(startMs/endMs)은 렌더링 단계에서 TTS/영상 길이에 맞춰 계산한다 (이 단계 범위 밖).
model ImageAsset {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  prompt    String
  // null이면 "빈 카드" — 아직 업로드/재생성으로 채워지지 않은 슬롯
  filePath  String?
  model     String
  // 이미지 생성 모델의 품질 티어 (예: OpenAI의 low/medium/high). 티어 개념이 없는 모델은 null.
  quality   String?
  size      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, order])
}

// 이미지+TTS 음성을 합성한 최종 영상. 자막(SRT)은 로컬 ffmpeg 빌드에 libass가 없어
// 이번 단계에서는 영상에 번인하지 않고 별도 사이드카 파일로만 생성한다.
model VideoAsset {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filePath     String
  subtitlePath String
  durationMs   Int
  width        Int
  height       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// UI_SPEC.md §4.5 "[썸네일] 탭": 캔버스 편집기로 만든 최종 썸네일 이미지. 프로젝트당 1개.
model ThumbnailAsset {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filePath  String
  width     Int
  height    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TimelineTrackType {
  SUBTITLE
  VIDEO
  IMAGE
  TTS
  AUDIO
  BGM
  SFX
}

// UI_SPEC.md §5.6 데이터 모델. PROJECT_SPEC.md §1.3 "타임라인 편집기 Phase B":
// "동기화"가 Script/ImageAsset/AudioSegment/BGM 설정으로부터 클립을 생성·갱신하고,
// 이후 드래그/트림/분할 등 실제 편집 상태는 이 테이블들에 저장된다.
model Timeline {
  id         String          @id @default(cuid())
  projectId  String          @unique
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  durationMs Int             @default(0)
  tracks     TimelineTrack[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model TimelineTrack {
  id         String            @id @default(cuid())
  timelineId String
  timeline   Timeline          @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  type       TimelineTrackType
  name       String
  order      Int
  visible    Boolean           @default(true)
  locked     Boolean           @default(false)
  // true: syncTimeline이 관리하는 자동 생성 트랙(타입당 최초 1개, 기존 동작). false: "트랙 추가"로
  // 사용자가 직접 만든 트랙 — syncTimeline이 절대 만들거나 지우지 않는다.
  autoSync   Boolean           @default(true)
  clips      TimelineClip[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model TimelineClip {
  id        String        @id @default(cuid())
  trackId   String
  track     TimelineTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  startMs   Int
  endMs     Int
  // 같은 트랙 안에서 클립끼리 겹칠 때 표출 우선순위(클수록 위). 드래그로 클립을 옮길 때마다
  // 같은 트랙 내 최댓값+1로 갱신되어 "방금 옮긴 클립이 항상 최상단"이 되게 한다.
  zIndex    Int           @default(0)
  // 타입별 내용: { sourceId?, label, text? } — sourceId로 원본 레코드(AudioSegment/ImageAsset 등)와 매칭해
  // "동기화"가 편집된 시간은 보존하고 내용만 갱신할 수 있도록 한다.
  payload   Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([trackId])
}

// PROJECT_SPEC.md §1.3 "트랙/클립 추가 기능": "직접 업로드"로 타임라인 클립에 추가한 파일.
// AudioSegment/ImageAsset처럼 자동 파이프라인이 만드는 게 아니라 사용자가 트랙에 직접 얹은 미디어라
// 별도 모델로 관리한다. TimelineClip.payload.mediaId로 참조된다.
model UploadedMedia {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       String // "video" | "image" | "audio"
  filePath   String
  durationMs Int? // 이미지는 고정 길이가 없어 null
  createdAt  DateTime @default(now())
}

// PROJECT_SPEC.md §1.3 "BGM 설정": 프로젝트에 종속되지 않는 전역 BGM 라이브러리.
// 브금대통령 채널 동기화(yt-dlp) 또는 직접 업로드로 채워진다.
model BgmTrack {
  id          String   @id @default(cuid())
  // 브금대통령 동기화로 받은 트랙의 원본 유튜브 videoId. 직접 업로드는 null.
  youtubeId   String?  @unique
  title       String
  category    String   @default("기타")
  durationSec Int?
  // storage/_bgm-library/ 기준 상대 경로
  filePath    String
  source      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum JobType {
  IMAGES
  RENDER
  TTS
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// 장시간 작업(일괄 이미지 생성, 렌더링)의 진행 상태. GET /api/projects/:id/events가
// 이 레코드를 폴링해 SSE로 전송한다.
model Job {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      JobType
  status    JobStatus @default(PENDING)
  progress  Int       @default(0)
  message   String?
  error     String?
  // 작업 실행에 필요한 입력값 (예: IMAGES 작업의 모델 선택/장면별 프롬프트 임시 조정)
  payload   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, type])
}

enum PrivacyStatus {
  PUBLIC
  UNLISTED
  PRIVATE
}

// 프로젝트별 YouTube 업로드 설정 및 결과.
model UploadConfig {
  id                 String        @id @default(cuid())
  projectId          String        @unique
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String?
  description        String?
  tags               Json
  privacyStatus      PrivacyStatus @default(PRIVATE)
  // 예약 업로드(Phase 4): 지정 시 YouTube API에 status.publishAt + privacyStatus=private로 전달한다.
  scheduledPublishAt DateTime?
  youtubeVideoId     String?
  uploadedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

// 외부 API 응답 범용 TTL 캐시 (lib/cache.ts). 엔티티별 구조화 캐시(CachedVideo 등)는
// 이를 소비하는 분석 화면을 구현할 때 별도로 설계한다.
model ApiCache {
  cacheKey  String   @id
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// YouTube Data API 쿼터 사용량 기록 (lib/quota.ts). date는 "YYYY-MM-DD" 형식의 일별 집계 키.
model QuotaUsage {
  id        String   @id @default(cuid())
  endpoint  String
  cost      Int
  date      String
  createdAt DateTime @default(now())

  @@index([date])
}

enum SavedItemType {
  VIDEO
  CHANNEL
  IDEA
}

// PROJECT_SPEC.md §2.3 "저장됨 (2.11)": 영상/채널/아이디어 스냅샷 저장(당시 지표 보존).
// snapshotJson은 type별로 형태가 다르므로 애플리케이션 레벨에서 스키마를 관리한다.
model SavedItem {
  id           String        @id @default(cuid())
  type         SavedItemType
  snapshotJson Json
  note         String?
  createdAt    DateTime      @default(now())

  @@index([type])
}

// UI_SPEC.md §7.1 "홈" "니치 설정 카드": 사용자가 설정한 관심 니치 카테고리 (AI 아이디어 품질에 직접 영향).
// 단일 사용자 앱이므로 사용자별 구분 없이 전역으로 관리한다.
model NicheSetting {
  id        String   @id @default(cuid())
  category  String   @unique
  createdAt DateTime @default(now())
}

// UI_SPEC.md §7.1 "홈" "오늘의 AI 아이디어": 하루 1묶음(5개 시드)을 캐싱해 재진입 시 그대로 보여준다.
// date는 "YYYY-MM-DD" — 같은 날 같은 모드로 재생성하면 upsert로 덮어쓴다.
// PROJECT_SPEC.md §2.3 "홈 (2.1)" 2026-07-24 수정: 자동/직접 입력 모드는 서로 독립적으로 저장되어야 하므로
// date 단독이 아니라 (date, mode) 조합을 유니크 키로 사용한다.
model DailyIdea {
  id        String   @id @default(cuid())
  date      String
  mode      String // "auto" | "manual"
  niches    Json
  ideasJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, mode])
}
